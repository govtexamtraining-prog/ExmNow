# ExmNow Environment Configuration
# Copy this file to .env.local and populate the secrets

# Supabase PostgreSQL Configuration (Optional - in-memory mock runs automatically if not set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI API Key (Used by RSS-to-AI sync engine & On-The-Fly Scraper)
GEMINI_API_KEY=your-gemini-api-key

# Vercel Automation Cron Secret
CRON_SECRET=super-secret-cron-token-2026

# Razorpay Webhook & Payment Credentials (UPI Unlocks)
RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_hmac
